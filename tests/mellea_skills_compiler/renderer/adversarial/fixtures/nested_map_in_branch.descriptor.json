{
  "descriptor_version": "0.1",
  "mellea_version": "0.5.0",
  "skill": { "name": "nested-map-in-branch", "classification": "DSL" },
  "inputs": [
    { "name": "query", "schema": { "kind": "str" } }
  ],
  "outputs": [
    { "name": "result", "schema": { "kind": "model_ref", "ref": "#/schemas/Item" } }
  ],
  "schemas": {
    "TriageKind": {
      "kind": "enum",
      "members": ["batch", "single"]
    },
    "Triage": {
      "kind": "model",
      "fields": {
        "kind": { "type": "enum_ref", "ref": "#/schemas/TriageKind" },
        "items": { "type": "list[str]" }
      }
    },
    "Item": {
      "kind": "model",
      "fields": {
        "name": { "type": "str" },
        "summary": { "type": "str" }
      }
    }
  },
  "state": [
    {
      "id": "backend",
      "symbol": "mellea.backends.openai.OpenAIBackend",
      "args": { "model_id": { "env": "MODEL_ID" } }
    },
    {
      "id": "session",
      "symbol": "mellea.stdlib.session.MelleaSession",
      "args": { "backend": { "ref": "backend" } }
    }
  ],
  "pipeline": [
    {
      "id": "triage",
      "kind": "call",
      "symbol": "mellea.stdlib.session.MelleaSession.instruct",
      "bound_to": { "ref": "session" },
      "args": {
        "description": { "template": "Triage the query as 'batch' or 'single': {query}" },
        "format": { "schema_ref": "#/schemas/Triage" }
      }
    },
    {
      "id": "dispatch",
      "kind": "composition",
      "operator": "branch",
      "on": { "ref": "triage", "select": "kind" },
      "cases": {
        "batch": [
          {
            "id": "per_item",
            "kind": "composition",
            "operator": "map",
            "over": { "ref": "triage", "select": "items" },
            "item_id": "item",
            "collect": "list",
            "body": [
              {
                "id": "describe_item",
                "kind": "call",
                "symbol": "mellea.stdlib.session.MelleaSession.instruct",
                "bound_to": { "ref": "session" },
                "args": {
                  "description": { "template": "Describe item {item}" },
                  "format": { "schema_ref": "#/schemas/Item" }
                }
              }
            ]
          }
        ],
        "_default": [
          {
            "id": "describe_single",
            "kind": "call",
            "symbol": "mellea.stdlib.session.MelleaSession.instruct",
            "bound_to": { "ref": "session" },
            "args": {
              "description": { "template": "Describe single query: {query}" },
              "format": { "schema_ref": "#/schemas/Item" }
            }
          }
        ]
      },
      "captures": { "result": "#/outputs/result" }
    }
  ]
}
